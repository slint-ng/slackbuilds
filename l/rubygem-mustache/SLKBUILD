# shellcheck shell=bash disable=SC2034,SC2154
# Packager: sektor

_gemname=mustache
pkgname=rubygem-$_gemname
pkgver=1.1.1
pkgrel=1slint
source=(
  "${_gemname}-${pkgver}.gem"
  "SLKBUILD"
)
url="https://github.com/mustache/mustache"
license=("MIT")
noextract=("${_gemname}-${pkgver}.gem")
options=("nosrcpack")

slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"rubygem-mustache (logic-free views)"
""
"Mustache is a framework-agnostic way to render logic-free views."
""
""
""
""
""
""
""
)

build() {
  local _gemdir

  _gemdir="$(ruby -e 'puts Gem.default_dir')" || return 1

  gem install --local --no-update-sources --ignore-dependencies --backtrace \
    --install-dir "$PKG/$_gemdir" \
    --bindir "$PKG/usr/bin" \
    "$SRC/${_gemname}-${pkgver}.gem" || return 1
  rm -f "$PKG/$_gemdir/cache/${_gemname}-${pkgver}.gem" || return 1
  rmdir "$PKG/$_gemdir/cache" 2>/dev/null || true

  mkdir -p "$PKG/usr/doc/$pkgname-$pkgver" || return 1
  tar -x -O --file="$SRC/${_gemname}-${pkgver}.gem" data.tar.gz | \
    tar -xz -C "$PKG/usr/doc/$pkgname-$pkgver" --file=- \
      LICENSE README.md || return 1
  tar -x -O --file="$SRC/${_gemname}-${pkgver}.gem" data.tar.gz | \
    tar -xz -C "$PKG/usr/doc/$pkgname-$pkgver" --strip-components=1 --file=- \
      man/mustache.1.html man/mustache.5.html || return 1
  mkdir -p "$PKG/usr/man/man1" "$PKG/usr/man/man5" || return 1
  tar -x -O --file="$SRC/${_gemname}-${pkgver}.gem" data.tar.gz | \
    tar -xz -C "$PKG/usr/man/man1" --strip-components=1 --file=- \
      man/mustache.1 || return 1
  tar -x -O --file="$SRC/${_gemname}-${pkgver}.gem" data.tar.gz | \
    tar -xz -C "$PKG/usr/man/man5" --strip-components=1 --file=- \
      man/mustache.5 || return 1
  install -Dm0644 "$SRC/SLKBUILD" \
    "$PKG/usr/doc/$pkgname-$pkgver/${pkgname}.SlackBuild" || return 1
}
