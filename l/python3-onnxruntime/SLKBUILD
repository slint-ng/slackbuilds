#!/bin/bash
# shellcheck shell=bash disable=SC2034
# Based on Arch onnxruntime packaging; CPU-only Python package for Slint.

pkgname=python3-onnxruntime
_srcname=onnxruntime
pkgver=1.24.2
pkgrel=1slint
arch=('x86_64')
slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"$pkgname (high performance ML inference engine for Python)"
"ONNX Runtime is a cross-platform inference engine for ONNX models."
"This package builds and installs the CPU Python runtime."
)
url='https://github.com/microsoft/onnxruntime'
license=('MIT')
depends=('python3' 'python3-numpy')
makedepends=('cmake' 'ninja' 'python3-setuptools' 'python3-build' 'python3-installer' 'python3-wheel' 'python3-numpy')
source=(
  "https://github.com/microsoft/onnxruntime/archive/refs/tags/v${pkgver}.tar.gz"
  'fix-thrust-api.patch'
)
sha256sums=('SKIP' 'SKIP')
options=('nosrcpack')

build() {
  cd "$SRC/${_srcname}-${pkgver}" || return 1

  patch -p1 -i "$SRC/fix-thrust-api.patch" || return 1

  cmake -S cmake -B build \
    -G Ninja \
    -Wno-dev \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -Donnxruntime_ENABLE_PYTHON=ON \
    -Donnxruntime_BUILD_SHARED_LIB=ON \
    -Donnxruntime_BUILD_UNIT_TESTS=OFF \
    -DBUILD_TESTING=OFF \
    -Donnxruntime_ENABLE_TRAINING=OFF \
    -Donnxruntime_USE_DNNL=ON \
    -Donnxruntime_USE_CUDA=OFF \
    -Donnxruntime_USE_MIGRAPHX=OFF \
    -Donnxruntime_USE_ROCM=OFF || return 1

  cmake --build build || return 1

  # Workaround used in Arch packaging for generated Python artifacts.
  mkdir -p onnxruntime/capi || return 1
  python3 setup.py --help >/dev/null || return 1
  cp -r build/onnxruntime/* onnxruntime/ || return 1

  python3 -m build --wheel --no-isolation || return 1
  python3 -m installer --destdir="$PKG" dist/*.whl || return 1

  install -Dm644 LICENSE "$PKG/usr/doc/$pkgname-$pkgver/LICENSE" || return 1
  if [[ -f ThirdPartyNotices.txt ]]; then
    install -Dm644 ThirdPartyNotices.txt "$PKG/usr/doc/$pkgname-$pkgver/ThirdPartyNotices.txt" || return 1
  fi
}
