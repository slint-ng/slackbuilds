# shellcheck shell=bash disable=SC2034,SC2154
# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=haskell-aeson
_hkgname=aeson
pkgver=2.2.0.0
pkgrel=1slint
arch=('x86_64' 'aarch64')
slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"haskell-aeson - Haskell library"
"A JSON parsing and encoding library optimized for ease of use "
"and high performance"
)
url="https://github.com/haskell/aeson"
license=('GPL')
depends=('ghc-libs' 'haskell-data-fix' 'haskell-dlist' 'haskell-generically' 'haskell-hashable' 'haskell-indexed-traversable' 'haskell-integer-conversion' 'haskell-network-uri' 'haskell-onetuple' 'haskell-primitive' 'haskell-quickcheck' 'haskell-scientific' 'haskell-semialign' 'haskell-strict' 'haskell-tagged' 'haskell-text-iso8601' 'haskell-text-short' 'haskell-th-abstraction' 'haskell-these' 'haskell-time-compat' 'haskell-unordered-containers' 'haskell-uuid-types' 'haskell-vector' 'haskell-witherable')
makedepends=('ghc')
source=("https://hackage.haskell.org/packages/archive/aeson/2.2.0.0/aeson-2.2.0.0.tar.gz")
sha512sums=('7a190d7c444668cf77a2789d0f339c4b69df464ee71f9c9ef2dd85e6e8ea5bcf1bf55687edd1789fb71017ba4a052e445fc945398585f33820b8da1530ee3592')
docs=('changelog' 'changes' 'license' 'readme')
options=('nosrcpack')

build() {
  local _ghc_version _pkgconf _pkgid _pkgconfdir

  cd "$startdir/src/${_hkgname}-${pkgver}" || return 1
  _ghc_version="$(ghc --numeric-version)"

  runhaskell Setup configure \
    --prefix=/usr \
    --libdir="/usr/lib${LIBDIRSUFFIX}" \
    --libsubdir="ghc-${_ghc_version}/${_hkgname}-${pkgver}" \
    --enable-shared \
    --enable-library-profiling \
    --disable-tests \
    --disable-benchmarks \
    --docdir="/usr/doc/${pkgname}-${pkgver}" || return 1

  runhaskell Setup build || return 1
  runhaskell Setup haddock || return 1
  runhaskell Setup copy --destdir="$startdir/pkg" || return 1
  runhaskell Setup register --gen-pkg-config || return 1

  _pkgconf="${_hkgname}-${pkgver}.conf"
  _pkgid="$(sed -n 's/^id:[[:space:]]*//p' "${_pkgconf}" | head -n1)"
  if [ -z "${_pkgid}" ]; then
    echo "Unable to determine package id from ${_pkgconf}."
    return 1
  fi

  _pkgconfdir="/usr/lib${LIBDIRSUFFIX}/ghc-${_ghc_version}/package.conf.d"
  install -dm755 "$startdir/pkg${_pkgconfdir}" || return 1
  mv "${_pkgconf}" "$startdir/pkg${_pkgconfdir}/${_pkgid}.conf" || return 1
}
