#!/bin/bash
# shellcheck shell=bash disable=SC2034
# Included in Slint Python 3.11 migration

pkgname=python3-cython
_srcname=cython
pkgver=3.0.12
pkgrel=1slint
source=("https://files.pythonhosted.org/packages/source/c/${_srcname}/${_srcname}-${pkgver}.tar.gz")
url="https://cython.org/"
license=("Apache-2.0")
depends=("python3")
makedepends=("python3-build" "python3-installer" "python3-setuptools" "python3-wheel")
options=("nosrcpack")

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"python3-cython (C extension compiler for Python 3)"
""
"Cython compiles Python-like code into C extension modules."
)

doinst() {
  local staleExt=
  local sitePackages=

  for sitePackages in \
    usr/lib/python3.11/site-packages \
    usr/lib64/python3.11/site-packages
  do
    for staleExt in \
      "$sitePackages/Cython/Compiler/Code.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Compiler/FlowControl.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Compiler/FusedNode.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Compiler/LineTable.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Compiler/Parsing.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Compiler/Scanning.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Compiler/Visitor.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Plex/Actions.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Plex/DFA.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Plex/Machines.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Plex/Scanners.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Plex/Transitions.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Runtime/refnanny.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/StringIOTree.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Tempita/_tempita.cpython-311-x86_64-linux-gnu.so" \
      "$sitePackages/Cython/Utils.cpython-311-x86_64-linux-gnu.so"
    do
      rm -f "$staleExt"
    done
  done
}

build() {
  local docDir
  local docFile
  local platlibDir
  local purelibDir

  docDir="$PKG/usr/doc/$pkgname-$pkgver"

  cd "${_srcname}-${pkgver}" || return 1
  export NO_CYTHON_COMPILE=true
  python3 -m build --wheel --no-isolation || return 1
  python3 -m installer --destdir="$PKG" dist/*.whl || return 1

  purelibDir="$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib").lstrip("/"))')" || return 1
  platlibDir="$(python3 -c 'import sysconfig; print(sysconfig.get_path("platlib").lstrip("/"))')" || return 1
  if [[ "$purelibDir" != "$platlibDir" && -d "$PKG/$purelibDir" ]]; then
    # Keep the active module path on multilib installs so upgrades replace the old copy.
    install -d "$PKG/${platlibDir%/*}" || return 1
    if [[ -e "$PKG/$platlibDir" ]]; then
      cp -a "$PKG/$purelibDir/." "$PKG/$platlibDir/" || return 1
      rm -rf "$PKG/${purelibDir:?}" || return 1
    else
      mv "$PKG/$purelibDir" "$PKG/$platlibDir" || return 1
    fi
    rmdir -p --ignore-fail-on-non-empty "$PKG/${purelibDir%/*}" 2>/dev/null || true
  fi

  if [[ ! -e "$PKG/usr/bin/cython3" && -e "$PKG/usr/bin/cython" ]]; then
    ln -sf cython "$PKG/usr/bin/cython3" || return 1
  fi
  if [[ ! -e "$PKG/usr/bin/cythonize3" && -e "$PKG/usr/bin/cythonize" ]]; then
    ln -sf cythonize "$PKG/usr/bin/cythonize3" || return 1
  fi
  if [[ ! -e "$PKG/usr/bin/cygdb3" && -e "$PKG/usr/bin/cygdb" ]]; then
    ln -sf cygdb "$PKG/usr/bin/cygdb3" || return 1
  fi

  install -d "$docDir" || return 1
  for docFile in CHANGES.rst COPYING.txt INSTALL.txt LICENSE.txt README.rst USAGE.txt; do
    [[ -e "$docFile" ]] || continue
    cp -a "$docFile" "$docDir/" || return 1
  done
}
