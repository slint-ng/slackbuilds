#!/bin/bash
# shellcheck shell=bash disable=SC2034
# Included in Slint by Didier Spaier <didier~at~slint~dot~fr>

pkgname=python3-idna
srcname=idna
export srcname
pkgver=3.3
pkgrel=2slint
source=("https://files.pythonhosted.org/packages/source/i/idna/idna-$pkgver.tar.gz")
url="https://github.com/kjd/idna"
license=("BSD-3-Clause")
depends=("python3")
makedepends=("python3-setuptools")

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"$pkgname (Internationalized Domain Names for Python)"
""
"Support for the Internationalised Domain Names in Applications"
"(IDNA) protocol as specified in RFC 5891, also referred to"
"as IDNA 2008."
""
"This library also provides support for Unicode Technical"
"Standard 46, Unicode IDNA Compatibility Processing."
""
"Homepage: https://github.com/kjd/idna"
)

build() {
  local docDir

  cd "$SRC/${srcname}-${pkgver}" || return 1

  python3 setup.py install --root="$PKG" || return 1

  docDir="$PKG/usr/doc/$pkgname-$pkgver"
  mkdir -p "$docDir" || return 1
  cp -a ./*.rst "$docDir" || return 1
  find "$docDir" -type f -exec chmod 0644 {} + || return 1

  if [ -r HISTORY.rst ]; then
    head -n 1000 HISTORY.rst > "$docDir/HISTORY.rst" || return 1
    touch -r HISTORY.rst "$docDir/HISTORY.rst" || return 1
  fi
}
