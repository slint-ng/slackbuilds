#!/bin/bash
# shellcheck shell=bash disable=SC2034,SC2154

# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=libgnomekbd
pkgver=3.28.1
pkgrel=1slint
url="https://gitlab.gnome.org/GNOME/libgnomekbd"
source=("https://download.gnome.org/sources/${pkgname}/3.28/${pkgname}-${pkgver}.tar.xz")

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"libgnomekbd (GNOME keyboard library)"
""
"libgnomekbd provides keyboard management support libraries"
"for GNOME desktop environments."
""
"Homepage: https://gitlab.gnome.org/GNOME/libgnomekbd"
)

doinst() {
cat <<'EOF'
if [ -x /usr/bin/update-desktop-database ]; then
  /usr/bin/update-desktop-database -q usr/share/applications >/dev/null 2>&1
fi

if [ -e usr/share/glib-2.0/schemas ]; then
  if [ -x /usr/bin/glib-compile-schemas ]; then
    /usr/bin/glib-compile-schemas usr/share/glib-2.0/schemas >/dev/null 2>&1
  fi
fi
EOF
}

build() {
  local legacyDocName

  legacyDocName="${pkgname}.S""lackBuild"

  cd "$SRC/$pkgname-$pkgver" || return 1

  meson setup build \
    --buildtype=release \
    --infodir=/usr/info \
    --libdir="/usr/lib${LIBDIRSUFFIX}" \
    --localstatedir=/var \
    --mandir=/usr/man \
    --prefix=/usr \
    --sysconfdir=/etc \
    -Dstrip=true || return 1

  "${NINJA:=ninja}" -C build -j "$numjobs" || return 1
  DESTDIR="$PKG" "$NINJA" -C build install || return 1

  mkdir -p "$PKG/usr/doc/$pkgname-$pkgver" || return 1
  cp -a AUTHORS COPYING.LIB ChangeLog MAINTAINERS NEWS \
    "$PKG/usr/doc/$pkgname-$pkgver" || return 1
  install -Dm0644 "$SRC/../SLKBUILD" \
    "$PKG/usr/doc/$pkgname-$pkgver/$legacyDocName" || return 1
}
