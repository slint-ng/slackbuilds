#!/bin/bash
# shellcheck shell=bash disable=SC2034
# Included in Slint by Didier Spaier <didier~at~slint~dot~fr>

pkgname=python-magic
_srcname=python-magic
pkgver=0.4.25
pkgrel=1slint
slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"$pkgname (ctypes bindings for libmagic)"
""
"python-magic uses ctypes to access libmagic for file type"
"identification and MIME detection."
""
"Homepage: https://github.com/ahupp/python-magic"
)
url="https://github.com/ahupp/python-magic"
depends=("python")
makedepends=("python-setuptools")
source=("https://files.pythonhosted.org/packages/source/p/${_srcname}/${_srcname}-${pkgver}.tar.gz")
options=("nosrcpack")

build() {
  cd "$SRC/${_srcname}-${pkgver}" || return 1

  rm -rf build || return 1
  python3 setup.py install --root="$PKG" || return 1

  docdir="$PKG/usr/doc/$pkgname-$pkgver"
  install -d "$docdir" || return 1
  install -m 0644 LICENSE "$docdir/LICENSE" || return 1
}
