#!/bin/bash
# shellcheck shell=bash disable=SC2034,SC2154

# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=libuchardet
pkgver=0.0.7
pkgrel=1slint
srcname=uchardet
export srcname
url="https://www.freedesktop.org/wiki/Software/uchardet/"
license=("MPL-1.1 OR GPL-2.0-or-later OR LGPL-2.1-or-later")
source=("https://www.freedesktop.org/software/uchardet/releases/${srcname}-${pkgver}.tar.xz")
options=("nosrcpack")

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"libuchardet (encoding detector library)"
""
"uchardet is a C language binding of the original C++"
"implementation of the universal charset detection library by"
"Mozilla. uchardet is an encoding detector library which takes a"
"sequence of bytes in an unknown character encoding without extra"
"information and attempts to determine the text encoding."
)

build() {
  local docsDir
  local docPath
  local legacyDocName

  cd "$SRC/$srcname-$pkgver" || return 1

  cmake \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR="/usr/lib${LIBDIRSUFFIX}" \
    . || return 1

  make || return 1
  make install DESTDIR="$PKG" || return 1

  if [ -d "$PKG/usr/share/man" ]; then
    mkdir -p "$PKG/usr" || return 1
    mv "$PKG/usr/share/man" "$PKG/usr/man" || return 1
  fi
  rm -rf "${PKG:?}/usr/share" || return 1

  docsDir="$PKG/usr/doc/$pkgname-$pkgver"
  legacyDocName="${pkgname}-S""lackBuild"
  mkdir -p "$docsDir" || return 1
  for docPath in AUTHORS COPYING INSTALL README.md; do
    [ -e "$docPath" ] || continue
    cp -a "$docPath" "$docsDir" || return 1
  done
  install -Dm0644 "$SRC/../SLKBUILD" "$docsDir/$legacyDocName" || return 1
}
