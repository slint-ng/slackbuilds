#!/bin/bash
# shellcheck shell=bash disable=SC2034,SC2154

# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=libmp4v2
pkgver=20191108_9084868
pkgrel=3slint
url="https://github.com/sergiomb2/libmp4v2"
source=(
  "https://github.com/sergiomb2/libmp4v2/archive/refs/tags/${pkgver}.tar.gz"
  "libmp4v2_gcc_narrowing.patch"
)
docs=("COPYING" "README")

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"libmp4v2 (library to read, create, and modify MP4 files)"
""
"libmp4v2 provides functions to read, create, and modify"
"MP4 files in a standalone library derived from the"
"mpeg4ip source tree."
""
"Homepage: https://github.com/sergiomb2/libmp4v2"
)

build() {
  local legacyDocName

  legacyDocName="${pkgname}.S""lackBuild"

  cd "$SRC/$pkgname-$pkgver" || return 1

  patch --verbose -p1 < "$SRC/../libmp4v2_gcc_narrowing.patch" || return 1

  autoreconf -vif || return 1

  ./configure \
    --prefix=/usr \
    --libdir="/usr/lib${LIBDIRSUFFIX}" \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --mandir=/usr/man \
    --build="$ARCH-slackware-linux" || return 1

  make -j"$numjobs" || make || return 1
  make install DESTDIR="$PKG" || return 1

  find "$PKG/usr/doc/$pkgname-$pkgver" -type f -exec chmod 0644 {} + || return 1
  rm -f "$PKG"/usr/lib*/*.la || return 1

  install -Dm0644 "$SRC/../SLKBUILD" \
    "$PKG/usr/doc/$pkgname-$pkgver/$legacyDocName" || return 1
}
