#!/bin/bash
# shellcheck shell=bash disable=SC2034,SC2154

# Packager: sektor

pkgname=perl-file-listing
pkgver=6.16
pkgrel=1slint
export srcname=File-Listing
source=("https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/File-Listing-$pkgver.tar.gz")
docs=("Changes" "README")
url="https://metacpan.org/pod/File::Listing"

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"perl-file-listing (parse directory listings)"
"File::Listing exports parse_dir() to parse directory listings"
"from Unix, Apache, and DOS FTP servers."
)

build() {
  cd "$SRC/$srcname-$pkgver" || exit 1

  printf 'y\n' | perl Makefile.PL \
    PREFIX=/usr \
    INSTALLDIRS=vendor \
    INSTALLVENDORMAN3DIR=/usr/man/man3
  make || exit 1
  make test || exit 1
  make install DESTDIR="$PKG" || exit 1

  find "$PKG" \( -name perllocal.pod -o -name .packlist -o -name '*.bs' \) -delete
}
