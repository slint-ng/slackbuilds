# shellcheck shell=bash disable=SC2034,SC2154
# Packager: sektor

_gemname=polyglot
pkgname=rubygem-$_gemname
pkgver=0.3.5
pkgrel=2slint
source=(
  "${_gemname}-${pkgver}.gem"
  "SLKBUILD"
)
url="http://rubygems.org/gems/polyglot"
license=("MIT")
noextract=("${_gemname}-${pkgver}.gem")
options=("nosrcpack")

slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"rubygem-polyglot (augments 'require' to find and load matching files)"
""
"rubygem-polyglot allows a Ruby module to register a loader for the"
"file type associated with a filename extension."
"To know more visit: https://rubygems.org/search?query=polyglot"
""
""
""
""
""
)

build() {
  local _gemdir

  _gemdir="$(ruby -e 'puts Gem.default_dir')" || return 1

  gem install --local --no-update-sources --ignore-dependencies --backtrace \
    --install-dir "$PKG/$_gemdir" \
    --bindir "$PKG/usr/bin" \
    "$SRC/${_gemname}-${pkgver}.gem" || return 1

  mkdir -p "$PKG/usr/doc/$pkgname-$pkgver" || return 1
  tar -x -O --file="$SRC/${_gemname}-${pkgver}.gem" data.tar.gz | \
    tar -xz -C "$PKG/usr/doc/$pkgname-$pkgver" --file=- \
      History.txt License.txt README.txt || return 1
  install -Dm0644 "$SRC/SLKBUILD" \
    "$PKG/usr/doc/$pkgname-$pkgver/${pkgname}.SlackBuild" || return 1
}
