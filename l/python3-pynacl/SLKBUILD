#!/bin/bash
# shellcheck shell=bash disable=SC2034
# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=python3-pynacl
srcname=PyNaCl
export srcname
pkgver=1.5.0
pkgrel=1slint
slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"$pkgname (Python 3 binding for libsodium)"
""
"PyNaCl is a Python binding to libsodium, a fork of the"
"Networking and Cryptography library focused on usability,"
"security, and speed."
""
"Homepage: https://pypi.org/project/PyNaCl/"
)
url="https://pypi.org/project/PyNaCl/"
depends=("python3" "python3-cffi")
makedepends=("python3-setuptools")
source=("https://files.pythonhosted.org/packages/source/P/${srcname}/${srcname}-${pkgver}.tar.gz")
options=("nosrcpack")

build() {
  cd "$SRC/${srcname}-${pkgver}" || return 1

  python3 setup.py install --root="$PKG" || return 1

  install -Dm 0644 PKG-INFO "$PKG/usr/doc/$pkgname-$pkgver/PKG-INFO" || return 1
}
