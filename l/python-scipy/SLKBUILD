#!/bin/bash
# shellcheck shell=bash disable=SC2034

pkgname=python-scipy
export srcname=scipy
pkgver=1.17.1
pkgrel=1slint
source=("https://files.pythonhosted.org/packages/source/s/${srcname}/${srcname}-${pkgver}.tar.gz")
sha256sums=('95d8e012d8cb8816c226aef832200b1d45109ed4464303e997c5b13122b297c0')
url="https://www.scipy.org/"
depends=("python3-numpy")
makedepends=("gcc-gfortran" "meson" "ninja" "python3-cython" "python3-pythran" "pybind11")
docs=("CONTRIBUTING.rst" "LICENSE.txt" "README.rst")

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"$pkgname (scientific computing library for Python)"
""
"SciPy extends NumPy with numerical routines and algorithms."
)

build() {
  cd "$SRC/${srcname}-${pkgver}" || return 1
  export PYTHONNOUSERSITE=1
  export CCACHE_DISABLE=1

  meson setup build \
    --prefix=/usr \
    --libdir=lib"${LIBDIRSUFFIX}" \
    --buildtype=release \
    -Dblas=blas \
    -Dlapack=lapack || return 1

  meson compile -C build -j "${numjobs:-1}" || return 1
  DESTDIR="$PKG" meson install -C build || return 1
}
