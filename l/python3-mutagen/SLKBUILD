#!/bin/bash
# shellcheck shell=bash disable=SC2034
#Included in Slint by Didier Spaier didieratslintdotfr

pkgname=python3-mutagen
export srcname=mutagen
pkgver=1.45.1
pkgrel=2slint
slackdesc="$pkgname An audio metadata tag reader and writer python library"
url="https://github.com/quodlibet/mutagen"
license=('GPL2')
docs=('NEWS' 'COPYING')
source=(
  "https://github.com/quodlibet/mutagen/releases/download/release-${pkgver}/mutagen-${pkgver}.tar.gz"
)
b2sums=('a1e29698d96b4c98f16e18dd8b3f902e41dcc4409d01da861a726a6a9fbd7f116e07b4e1872b8b3857f0eec080d18bac736de741635746f5c71416a3a8ef6e78')

build() {
  cd "$SRC/${srcname}-${pkgver}" || return 1
  python3 setup.py build || return 1
  python3 setup.py install --optimize=1 --root="$PKG" || return 1
  mkdir -p "$PKG/usr/doc/${pkgname}-${pkgver}" || return 1
  cp README.rst "$PKG/usr/doc/${pkgname}-${pkgver}/" || return 1
}
