#!/bin/bash
# shellcheck shell=bash disable=SC2034,SC2154

# Packager: sektor

pkgname=perl-Sub-Uplevel
pkgver=0.2800
pkgrel=1slint
export srcname=Sub-Uplevel
source=("https://cpan.metacpan.org/authors/id/D/DA/DAGOLDEN/$srcname-$pkgver.tar.gz")
docs=("Changes" "LICENSE" "README")
url="https://metacpan.org/pod/Sub::Uplevel"

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"perl-Sub-Uplevel (run a function in a higher frame)"
"Sub::Uplevel allows running a function in a higher"
"stack frame."
)

build() {
  cd "$SRC/$srcname-$pkgver" || exit 1

  perl Makefile.PL \
    PREFIX=/usr \
    INSTALLDIRS=vendor \
    INSTALLVENDORMAN3DIR=/usr/man/man3
  make || exit 1
  make install DESTDIR="$PKG" || exit 1

  find "$PKG" \( -name perllocal.pod -o -name .packlist -o -name '*.bs' \) -delete
  find "$PKG" -depth -type d -empty -delete || exit 1
}
