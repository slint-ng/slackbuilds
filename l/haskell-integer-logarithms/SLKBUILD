# shellcheck shell=bash disable=SC2034,SC2154
# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=haskell-integer-logarithms
_hkgname=integer-logarithms
pkgver=1.0.4
pkgrel=1slint
arch=('x86_64' 'aarch64')
slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"haskell-integer-logarithms (Integer logarithms)"
"Integer logarithms"
"Built from upstream source archives."
)
url="https://github.com/Bodigrim/integer-logarithms"
license=('MIT')
depends=('ghc-libs')
makedepends=('ghc')
source=("https://hackage.haskell.org/packages/archive/integer-logarithms/1.0.4/integer-logarithms-1.0.4.tar.gz")
sha512sums=('aa9eddff5bc8db9f1cca8a9250388d6d84498b1d443acecae116ac79ef50c7d5aa0ff3d018e8d999f0990d2862d5de87ec8971339bec571b417db6bbeaca8586')
options=('nosrcpack')

build() {
  local _ghc_version _pkgconf _pkgid _pkgconfdir

  cd "$SRC/${_hkgname}-${pkgver}" || exit 1
  _ghc_version="$(ghc --numeric-version)"

  runhaskell Setup configure \
    --prefix=/usr \
    --libdir="/usr/lib${LIBDIRSUFFIX}" \
    --libsubdir="ghc-${_ghc_version}/${_hkgname}-${pkgver}" \
    --enable-shared \
    --enable-library-profiling \
    --disable-tests \
    --disable-benchmarks \
    --docdir="/usr/doc/${pkgname}-${pkgver}" || exit 1

  runhaskell Setup build || exit 1
  runhaskell Setup haddock || exit 1
  runhaskell Setup copy --destdir="$PKG" || exit 1
  runhaskell Setup register --gen-pkg-config || exit 1

  _pkgconf="${_hkgname}-${pkgver}.conf"
  _pkgid="$(sed -n 's/^id:[[:space:]]*//p' "${_pkgconf}" | head -n1)"
  if [ -z "${_pkgid}" ]; then
    echo "Unable to determine package id from ${_pkgconf}."
    exit 1
  fi

  _pkgconfdir="/usr/lib${LIBDIRSUFFIX}/ghc-${_ghc_version}/package.conf.d"
  install -dm755 "$PKG${_pkgconfdir}" || exit 1
  mv "${_pkgconf}" "$PKG${_pkgconfdir}/${_pkgid}.conf" || exit 1

  install -dm755 "$PKG/usr/doc/${pkgname}-${pkgver}" || exit 1
  for _doc in CHANGELOG* CHANGES* LICENSE* README*; do
    [ -f "${_doc}" ] && install -m644 "${_doc}" "$PKG/usr/doc/${pkgname}-${pkgver}/"
  done
}
