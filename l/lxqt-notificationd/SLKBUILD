#!/bin/bash
# shellcheck shell=bash disable=SC2034,SC2154

pkgname=lxqt-notificationd
pkgver=2.3.1
pkgrel=1slint
options=("noautodotnew")
source=("https://github.com/lxqt/lxqt-notificationd/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.xz")
url="https://github.com/lxqt/lxqt-notificationd"
docs=("AUTHORS" "CHANGELOG" "LICENSE" "README.md")

slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"lxqt-notificationd (LXQt desktop notification daemon)"
""
"lxqt-notificationd provides LXQt's notification daemon"
"and settings utility for desktop pop-up messages."
)

build() {
  local legacyDocName

  legacyDocName="${pkgname}.S""lackBuild"

  cd "$SRC/$pkgname-$pkgver" || return 1

  cmake \
    -S . \
    -B build \
    -DCMAKE_C_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_CXX_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release || return 1

  cmake --build build || return 1
  DESTDIR="$PKG" cmake --install build || return 1

  find "$PKG" \( -name perllocal.pod -o -name .packlist -o -name '*.bs' \) \
    -exec rm -f {} + || return 1

  install -Dm0644 "$SRC/../SLKBUILD" \
    "$PKG/usr/doc/$pkgname-$pkgver/$legacyDocName" || return 1
}
