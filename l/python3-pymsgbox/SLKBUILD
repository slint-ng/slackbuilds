#!/bin/bash
# shellcheck shell=bash disable=SC2034

pkgname=python3-pymsgbox
export srcname=pymsgbox
pkgver=2.0.1
pkgrel=1slint
url="https://github.com/asweigart/PyMsgBox"
depends=("python3")
makedepends=("python3-build" "python3-installer" "python3-wheel")
source=("https://files.pythonhosted.org/packages/ae/6a/e80da7594ee598a776972d09e2813df2b06b3bc29218f440631dfa7c78a8/${srcname}-${pkgver}.tar.gz")
options=("nosrcpack")

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"$pkgname (simple message boxes)"
""
"PyMsgBox provides JavaScript-like message boxes in Python."
)

build() {
  local docDir

  docDir="$PKG/usr/doc/$pkgname-$pkgver"

  cd "$SRC/${srcname}-${pkgver}" || return 1
  if [[ -f pyproject.toml ]]; then
    sed -i '/Programming Language :: Python :: 3\.14/d' pyproject.toml || return 1
    sed -i '/tool\.setuptools_scm/,/^\[/{/^\[/!d;}' pyproject.toml || return 1
  fi
  python3 -m build --wheel --no-isolation || return 1
  python3 -m installer --destdir="$PKG" dist/*.whl || return 1

  install -d "$docDir" || return 1
  shopt -s nullglob
  for docFile in AUTHORS AUTHORS.txt CHANGELOG ChangeLog CHANGES CHANGES.txt CHANGES.md COPYING COPYING.txt LICENSE LICENSE.txt README README.md README.rst README.txt PKG-INFO; do
    [[ -e "$docFile" ]] || continue
    cp -a "$docFile" "$docDir/" || return 1
  done
  shopt -u nullglob
}
