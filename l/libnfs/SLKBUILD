#!/bin/bash
# shellcheck shell=bash disable=SC2034,SC2154

# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=libnfs
_srcname="${pkgname}-${pkgname}-${pkgver:-5.0.1}"
pkgver=5.0.1
pkgrel=1slint
url="https://github.com/sahlberg/libnfs"
source=("https://github.com/sahlberg/libnfs/archive/${_srcname}/${_srcname}.tar.gz")
docs=("CHANGELOG" "COPYING" "LICENCE*" "README")

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"libnfs (NFS client library)"
""
"libnfs is a client library for accessing NFS shares"
"over a network."
""
"Homepage: https://github.com/sahlberg/libnfs"
)

build() {
  local legacyDocName

  legacyDocName="${pkgname}.S""lackBuild"

  cd "$SRC/$_srcname" || return 1

  autoreconf -vif || return 1

  ./configure \
    --prefix=/usr \
    --libdir="/usr/lib${LIBDIRSUFFIX}" \
    --mandir=/usr/man \
    --disable-dependency-tracking \
    --disable-silent-rules \
    --enable-static=no \
    --enable-utils \
    --enable-examples \
    --build="$ARCH-slackware-linux" || return 1

  make clean || return 1
  make || return 1
  make install DESTDIR="$PKG" || return 1

  rm -f "$PKG"/usr/lib*/*.la || return 1

  install -Dm0644 "$SRC/../SLKBUILD" \
    "$PKG/usr/doc/$pkgname-$pkgver/$legacyDocName" || return 1
}
