# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=python3-setproctitle
_srcname=setproctitle
pkgver=1.3.3
pkgrel=1slint
export srcnam="py-setproctitle-version"
slackdesc="$pkgname (lets a Python process change its title)"
license=("BSD")
url="https://github.com/dvarrazzo/py-setproctitle"
depends=('python3')
makedepends=(python3-setuptools python3-wheel python3-build python3-installer)
checkdepends=('python-pytest' 'procps-ng')
arch=('x86_64')
source=("https://files.pythonhosted.org/packages/source/s/setproctitle/setproctitle-${pkgver}.tar.gz")
sha256sums=('b9fb97907c830d260fa0658ed58afd48a86b2b88aac521135c352ff7fd3477fd')
docs=("COPYRIGHT" "HISTORY.rst" "README.html")

build() {
    cd "$_srcname-$pkgver" || exit 1
    pandoc -f rst -t html5 -o README.html README.rst || exit 1
    python3.11 -m build --wheel --no-isolation || exit 1
    python3.11 -m installer --destdir="$PKG" dist/*.whl || exit 1
}
