#!/bin/bash
# shellcheck shell=bash disable=SC2034,SC2154

# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=libdbus-c++
pkgver=20160924_e3455d2
pkgrel=3slint
url="https://dbus-cplusplus.sourceforge.net/"
license=("LGPL-2.1-or-later")
source=(
  "https://ponce.cc/slackware/sources/repo/${pkgname}-${pkgver}.tar.xz"
  "pipe-write-pointer.patch"
)
options=("nosrcpack")

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"libdbus-c++ (C++ API for D-Bus)"
""
"DBus-c++ attempts to provide a C++ API for D-Bus. The library has"
"glib and Ecore mainloop integration. It also offers an optional"
"main loop of its own."
)

build() {
  local docdir empty_doc legacyDocName

  legacyDocName="${pkgname}.S""lackBuild"

  cd "$SRC/$pkgname-$pkgver" || return 1

  patch -p1 < "$SRC/../pipe-write-pointer.patch" || return 1

  ./bootstrap || return 1

  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib"${LIBDIRSUFFIX}" \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --mandir=/usr/man \
    --disable-static \
    --disable-ecore \
    --disable-examples \
    --build="$ARCH-slackware-linux" || return 1

  make -j "$numjobs" || return 1
  make install-strip DESTDIR="$PKG" || return 1

  rm -f \
    "$PKG/lib${LIBDIRSUFFIX}"/*.la \
    "$PKG/usr/lib${LIBDIRSUFFIX}"/*.la || return 1

  docdir="$PKG/usr/doc/$pkgname-$pkgver"

  mkdir -p "$docdir" || return 1
  cp -a AUTHORS ChangeLog COPYING INSTALL NEWS README TODO "$docdir" || return 1

  # slkbuild prunes zero-length docs, so preserve upstream placeholders.
  for empty_doc in ChangeLog NEWS; do
    if [[ -f "$docdir/$empty_doc" && ! -s "$docdir/$empty_doc" ]]; then
      printf '\n' > "$docdir/$empty_doc" || return 1
    fi
  done

  install -Dm0644 "$SRC/../SLKBUILD" \
    "$docdir/$legacyDocName" || return 1
}
