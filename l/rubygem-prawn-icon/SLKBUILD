# shellcheck shell=bash disable=SC2034,SC2154
# Packager: sektor

_gemname=prawn-icon
pkgname=rubygem-$_gemname
pkgver=3.0.0
pkgrel=1slint
source=(
  "${_gemname}-${pkgver}.gem"
  "SLKBUILD"
)
url="https://github.com/Blocknotes/prawn-icon"
license=("GPL-3.0-only")
noextract=("${_gemname}-${pkgver}.gem")
options=("nosrcpack")

slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"rubygem-prawn-icon (various icon fonts for the Prawn PDF toolkit)"
""
"To know more visit: https://rubygems.org/search?query=prawn-icon"
""
""
""
""
""
""
""
)

build() {
  local _gemdir

  _gemdir="$(ruby -e 'puts Gem.default_dir')" || return 1

  gem install --local --no-update-sources --ignore-dependencies --backtrace \
    --install-dir "$PKG/$_gemdir" \
    --bindir "$PKG/usr/bin" \
    "$SRC/${_gemname}-${pkgver}.gem" || return 1

  mkdir -p "$PKG/usr/doc/$pkgname-$pkgver" || return 1
  tar -x -O --file="$SRC/${_gemname}-${pkgver}.gem" data.tar.gz | \
    tar -xz -C "$PKG/usr/doc/$pkgname-$pkgver" --file=- \
      CHANGELOG.md LICENSE README.md COPYING GPLv2 GPLv3 || return 1
  install -Dm0644 "$SRC/SLKBUILD" \
    "$PKG/usr/doc/$pkgname-$pkgver/${pkgname}.SlackBuild" || return 1
}
