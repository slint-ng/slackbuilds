# shellcheck shell=bash disable=SC2034,SC2154
# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=haskell-semigroupoids
_hkgname=semigroupoids
pkgver=6.0.1
pkgrel=1slint
arch=('x86_64' 'aarch64')
slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"haskell-semigroupoids - Semigroupoids: Category sans id"
"Semigroupoids: Category sans id"
"Built from upstream source archives."
)
url="https://github.com/ekmett/semigroupoids"
license=('BSD')
depends=('ghc-libs' 'haskell-base-orphans' 'haskell-bifunctors' 'haskell-comonad' 'haskell-contravariant' 'haskell-distributive' 'haskell-foldable1-classes-compat' 'haskell-hashable' 'haskell-tagged' 'haskell-transformers-compat' 'haskell-unordered-containers')
makedepends=('ghc')
source=("https://hackage.haskell.org/packages/archive/semigroupoids/6.0.1/semigroupoids-6.0.1.tar.gz")
sha512sums=('0d0e3b5dca7680b39385b80f6a216696274e617a34d25ab49f2cb4671042024b5cb2f6f0c17c0f03a2e19871a60524b10147174f276d89a8ab3751a899727544')
docs=('changelog' 'changes' 'license' 'readme')
options=('nosrcpack')

build() {
  local _ghc_version _pkgconf _pkgid _pkgconfdir

  cd "$startdir/src/${_hkgname}-${pkgver}" || return 1
  _ghc_version="$(ghc --numeric-version)"

  runhaskell Setup configure \
    --prefix=/usr \
    --libdir="/usr/lib${LIBDIRSUFFIX}" \
    --libsubdir="ghc-${_ghc_version}/${_hkgname}-${pkgver}" \
    --enable-shared \
    --enable-library-profiling \
    --disable-tests \
    --disable-benchmarks \
    --docdir="/usr/doc/${pkgname}-${pkgver}" || return 1

  runhaskell Setup build || return 1
  runhaskell Setup haddock || return 1
  runhaskell Setup copy --destdir="$startdir/pkg" || return 1
  runhaskell Setup register --gen-pkg-config || return 1

  _pkgconf="${_hkgname}-${pkgver}.conf"
  _pkgid="$(sed -n 's/^id:[[:space:]]*//p' "${_pkgconf}" | head -n1)"
  if [ -z "${_pkgid}" ]; then
    echo "Unable to determine package id from ${_pkgconf}."
    return 1
  fi

  _pkgconfdir="/usr/lib${LIBDIRSUFFIX}/ghc-${_ghc_version}/package.conf.d"
  install -dm755 "$startdir/pkg${_pkgconfdir}" || return 1
  mv "${_pkgconf}" "$startdir/pkg${_pkgconfdir}/${_pkgid}.conf" || return 1
}
