#!/bin/bash
# shellcheck shell=bash disable=SC2034,SC2154

# Included in Slint by Didier Spaier <didier~at~slint~dot~fr>

pkgname=speech-dispatcher3.11
pkgver=0.12.1
pkgrel=3slint
arch=noarch
depends=("speech-dispatcher")
source=()
url="https://devel.freebsoft.org/speechd"
options=("nosrcpack")

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"speech-dispatcher3.11 (compatibility package for speech-dispatcher)"
""
"This compatibility package keeps the historical"
"speech-dispatcher3.11 name available for packages that still"
"reference it."
""
"It depends on the canonical speech-dispatcher package."
)

build() {
  local docDir=""

  docDir="$PKG/usr/doc/$pkgname-$pkgver"

  mkdir -p "$docDir" || return 1
  install -Dm0644 "$startdir/SLKBUILD" "$docDir/SLKBUILD" || return 1
}
