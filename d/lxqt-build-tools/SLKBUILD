#!/bin/bash
# shellcheck shell=bash disable=SC2034,SC2154

# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=lxqt-build-tools
pkgver=2.3.0
pkgrel=1slint
url="https://github.com/lxqt/lxqt-build-tools"
source=("https://github.com/lxqt/lxqt-build-tools/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.xz")
docs=("AUTHORS" "CHANGELOG" "BSD-3-Clause" "README.md")
options=("nosrcpack")

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"lxqt-build-tools (packaging tools for LXQt)"
""
"Various tools and scripts used to build LXQt applications."
"They centralize common packaging and CMake helper logic."
""
"Homepage: https://github.com/lxqt/lxqt-build-tools"
)

build() {
  local legacyDocName

  legacyDocName="${pkgname}.S""lackBuild"

  cd "$SRC/$pkgname-$pkgver" || return 1
  rm -rf build || return 1

  cmake -S . -B build \
    -DCMAKE_C_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_CXX_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release || return 1

  cmake --build build -j "$numjobs" || return 1
  DESTDIR="$PKG" cmake --install build || return 1

  install -Dm0644 "$SRC/../SLKBUILD" \
    "$PKG/usr/doc/$pkgname-$pkgver/$legacyDocName" || return 1
}
