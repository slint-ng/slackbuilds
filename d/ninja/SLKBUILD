# shellcheck shell=bash disable=SC2034,SC2154
# Packager: Didier Spaier didieratslintdotfr

pkgname=ninja
pkgver=1.12.1
pkgrel=1slint
source=("https://github.com/ninja-build/ninja/archive/refs/tags/v${pkgver}.tar.gz")
url="https://ninja-build.org/"

docs=("COPYING*" "HACKING*" "README*" "RELEASING")

slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"ninja (build system with a focus on speed)"
""
"Ninja is a small build system with a focus on speed."
"It is designed to have its input files generated by"
"a higher-level build system and to run builds as fast"
"as possible."
""
"Homepage: https://ninja-build.org/"
""
""
)

build() {
  cd "$SRC/$pkgname-$pkgver" || exit 1

  LDFLAGS="$LDFLAGS" \
  CXXFLAGS="$SLKCFLAGS" \
  CFLAGS="$SLKCFLAGS" \
    python3 configure.py --bootstrap || exit 1

  install -D -m0755 ninja "$PKG/usr/bin/ninja" || exit 1
  install -D -m0644 misc/bash-completion \
    "$PKG/usr/share/bash-completion/completions/ninja" || exit 1
  install -D -m0644 misc/zsh-completion \
    "$PKG/usr/share/zsh/site-functions/_ninja" || exit 1
  install -D -m0644 misc/ninja.vim \
    "$PKG/usr/share/vim/vimfiles/syntax/ninja.vim" || exit 1
  install -D -m0644 misc/ninja-mode.el \
    "$PKG/usr/share/emacs/site-lisp/ninja-mode.el" || exit 1

  ./ninja manual doc/manual.html || exit 1

  mkdir -p "$PKG/usr/doc/$pkgname-$pkgver" || exit 1
  cp -a doc/manual.html "$PKG/usr/doc/$pkgname-$pkgver/" || exit 1
}
