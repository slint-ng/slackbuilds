# shellcheck shell=bash disable=SC2034,SC2154
# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=tk
pkgver=8.6.15
pkgrel=1slint
source=("https://downloads.sourceforge.net/tcl/tk${pkgver}-src.tar.gz")
url="https://www.tcl.tk"
depends=('tcl')
makedepends=('pandoc' 'tcl')

slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"tk (Tk toolkit for Tcl)"
"Tk extends Tcl with widgets and utilities to quickly build classic"
"X11 graphical applications."
)

build() {
  if [ -n "${ARCH:-}" ]; then
    build_arch="$ARCH"
  else
    build_arch="$arch"
    if [[ "$build_arch" == i?86 ]]; then
      build_arch=i686
    fi
  fi

  if [ "$build_arch" = "i686" ]; then
    tk_slkcflags="-O2 -march=pentium4 -mtune=generic"
  elif [ "$build_arch" = "x86_64" ]; then
    tk_slkcflags="-O2 -march=x86-64 -mtune=generic -fPIC"
  else
    tk_slkcflags="-O2"
  fi

  cd "$startdir/src/tk$pkgver" || cd "$startdir/src/tk8.6.11" || return 1

  sed -i \
    "s#TK_LIBRARY='\$(prefix)/lib/#TK_LIBRARY='\$(libdir)/#" \
    unix/configure || return 1

  chown -R root:root .
  find -L . \
    \( -perm 777 -o -perm 775 -o -perm 711 -o -perm 555 -o -perm 511 \) \
    -exec chmod 755 {} \+ -o \
    \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o \
       -perm 400 \) \
    -exec chmod 644 {} \+

  mkdir -p "$PKG/usr/doc/tk$pkgver" || return 1
  cp -a README* license.terms "$PKG/usr/doc/tk$pkgver" || return 1
  pandoc README.md -o "$PKG/usr/doc/tk$pkgver/README.html" || return 1

  cd unix || return 1
  CFLAGS="$tk_slkcflags" \
  ./configure \
    --prefix=/usr \
    --libdir="/usr/lib${LIBDIRSUFFIX}" \
    --enable-shared \
    --enable-threads \
    --enable-64bit \
    --mandir=/usr/man \
    --enable-man-symlinks \
    --build="$build_arch-slackware-linux" || return 1

  make || return 1

  sed -e "s@^\(TK_SRC_DIR='\).*@\1/usr/include'@" \
      -e "/TK_B/s@='\(-L\)\?.*unix@='\1/usr/lib${LIBDIRSUFFIX}@" \
      -i tkConfig.sh || return 1

  make install DESTDIR="$PKG" || return 1
  make install-private-headers DESTDIR="$PKG" || return 1

  (
    cd "$PKG/usr/bin" || return 1
    ln -sf wish8.6 wish || return 1
  ) || return 1

  (
    cd "$PKG/usr/lib${LIBDIRSUFFIX}" || return 1
    ln -sf libtk8.6.so libtk.so || return 1
  ) || return 1

  find "$PKG" -type f -print0 \
    | xargs -0 file \
    | grep -E "executable|shared object" \
    | grep ELF \
    | cut -d: -f1 \
    | xargs strip --strip-unneeded 2>/dev/null || true

  if [ -d "$PKG/usr/man" ]; then
    find "$PKG/usr/man" -type f ! -name '*.gz' -exec gzip -9 {} \+ \
      || return 1
    while IFS= read -r -d '' link; do
      ln -sf "$(readlink "$link").gz" "${link}.gz" || return 1
      rm -f "$link" || return 1
    done < <(find "$PKG/usr/man" -type l ! -name '*.gz' -print0)
  fi
}
