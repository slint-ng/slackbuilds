pkgname=kernel-firmware
_fwdate=20260110
_fwcommit=06a743f
pkgver="${_fwdate}_${_fwcommit}"
pkgrel=1slint
arch=noarch
source=(
  "https://www.kernel.org/pub/linux/kernel/firmware/linux-firmware-${_fwdate}.tar.xz"
  "kernel.firmware"
)
url="https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git"
_srcname="linux-firmware-${_fwdate}"

slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"kernel-firmware (Firmware for the kernel)"
""
"These are firmware files for the Linux kernel."
""
"You'll need these to use certain hardware drivers"
"with Linux."
""
"Upstream:"
"git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git"
""
)

build() {
  local installtarget=""
  local docdir="$PKG/usr/doc/$pkgname-$pkgver"
  local doc=""
  local docspec=""
  local srcdoc=""
  local destdoc=""

  cd "$_srcname" || return 1
  chown -R root:root .
  chmod -R a-st,u+rwX,go-w+rX .

  case "${COMPRESSION:-xz}" in
    xz) installtarget="install-xz" ;;
    zstd) installtarget="install-zst" ;;
    none) installtarget="install" ;;
    *) installtarget="install" ;;
  esac

  echo "Running make -j${numjobs} DESTDIR=$PKG ${installtarget}..."
  make -j"$numjobs" DESTDIR="$PKG" "$installtarget" 2>/dev/null || return 1

  mkdir -p "$docdir" || return 1
  if [ -f README.md ]; then
    cp -a README.md "$docdir/README.linux-firmware" || return 1
  elif [ -f README ]; then
    cp -a README "$docdir/README.linux-firmware" || return 1
  fi
  cp -a WHENCE "$docdir/WHENCE.linux-firmware" || return 1
  for doc in GPL* LICEN*; do
    [ -e "$doc" ] || continue
    cp -a "$doc" "$docdir/" || return 1
  done

  for docspec in \
    "amd-ucode/README:README.amd-ucode" \
    "isci/README:README.isci" \
    "carl9170fw/COPYRIGHT:COPYRIGHT.carl9170fw" \
    "carl9170fw/README:README.carl9170fw" \
    "rtw88/README:README.rtw88" \
    "wfx/LICENCE.wf200:LICENCE.wf200"; do
    srcdoc=${docspec%%:*}
    destdoc=${docspec#*:}
    [ -e "$srcdoc" ] || continue
    cp -a "$srcdoc" "$docdir/$destdoc" || return 1
  done

  cp -a ../kernel.firmware "$docdir/" || return 1
}
