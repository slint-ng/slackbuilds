# shellcheck shell=bash disable=2034
# Packager: sektor

pkgname=dracut
pkgver=108
pkgrel=1slint
source=("https://github.com/dracut-ng/dracut-ng/archive/refs/tags/${pkgver}.tar.gz")
url="https://github.com/dracut-ng/dracut"
docs=("AUTHORS" "COPYING" "README.md" "dracut.conf.d")
slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"dracut: dracut (An event driven initramfs infrastructure)"
"dracut:"
"dracut:"
"dracut:"
"dracut:"
"dracut:"
"dracut:"
"dracut:"
"dracut:"
"dracut:"
)
_srcname="dracut-ng-${pkgver}"
build() {
    cd "${_srcname}" || return 1
  # Let's put libs in /usr/lib${LIBDIRSUFFIX} as does Slackware
  # although does it really matter?
  sed -i "s|/usr/lib/dracut|/usr/lib${LIBDIRSUFFIX}/dracut|g" ./*.sh
  ./configure \
    --prefix=/usr \
    --libdir="/usr/lib${LIBDIRSUFFIX}" \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --mandir=/usr/man \
    --infodir=/usr/info \
    || return 1
  make -j"${NUMJOBS}" || make || return 1
  make install DESTDIR="$PKG"
}
