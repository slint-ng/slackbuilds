# Packager: sektor

pkgname=psutil
pkgver=5.8.0
pkgrel=1slint
source=("https://github.com/giampaolo/psutil/archive/release-${pkgver}/${pkgname}-release-${pkgver}.tar.gz")
url="https://github.com/giampaolo/psutil"
docs=("*.rst")
slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"psutil: psutil (python interface for process and system info)"
)

build() {
  # Remove shebangs
  find psutil -name "*\.py" | while read line; do
    sed -i.orig '/^#!/d' $line
    touch -r ${line}.orig $line
    rm ${line}.orig
  done
  python3 setup.py install --root=$PKG

}
