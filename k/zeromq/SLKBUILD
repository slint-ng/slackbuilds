# shellcheck shell=bash disable=SC2034,SC2154
# Packager: Didier Spaier didieratslintdotfr

pkgname=zeromq
pkgver=4.3.4
pkgrel=1slint
arch=x86_64
source=("https://github.com/zeromq/libzmq/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
url="http://www.zeromq.org/"

slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"zeromq (lightweight messaging kernel library)"
""
"ZeroMQ is a library which extends standard socket interfaces"
"with features traditionally provided by messaging middleware."
"It provides asynchronous message queues, multiple patterns,"
"message filtering, and access to multiple transport protocols."
""
""
""
""
)

build() {
  cd "$startdir/src/$pkgname-$pkgver" || return 1
  chown -R root:root .
  find -L . \
    \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
       -o -perm 511 \) -exec chmod 755 {} \; -o \
    \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
       -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS" \
  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib64 \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --mandir=/usr/man \
    --docdir=/usr/doc/$pkgname-$pkgver \
    --enable-static=no \
    --build="$arch-slackware-linux" || return 1
  make -j "$numjobs" || return 1
  make install DESTDIR="$PKG" || return 1

  rm -f "$PKG/usr/lib64/"*.la

  find "$PKG" -print0 | xargs -0 file | \
    grep -e "executable" -e "shared object" | grep ELF | \
    cut -f 1 -d : | xargs -r strip --strip-unneeded 2>/dev/null || true

  find "$PKG/usr/man" -type f -exec gzip -9 {} \;
  find "$PKG/usr/man" -type l -print0 | while IFS= read -r -d '' i; do
    ln -s "$(readlink "$i").gz" "$i.gz"
    rm "$i"
  done

  mkdir -p "$PKG/usr/doc/$pkgname-$pkgver" || return 1
  for f in AUTHORS COPYING COPYING.LESSER ChangeLog NEWS doc; do
    [ -e "$f" ] || continue
    cp -a "$f" "$PKG/usr/doc/$pkgname-$pkgver/" || return 1
  done
}
