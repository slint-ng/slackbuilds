pkgname=python-pyasn1-modules
_srcname=pyasn1-modules
pkgver=0.2.8
pkgrel=1slint
arch=x86_64
source=("https://files.pythonhosted.org/packages/source/p/pyasn1-modules/${_srcname}-${pkgver}.tar.gz")
url="https://pypi.python.org/pypi/pyasn1-modules/"

slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"python-pyasn1-modules (ASN.1 protocol modules for Python)"
""
"A collection of ASN.1-based protocol modules for Python."
"All modules are Python 2 and Python 3 compliant."
""
"Homepage: https://pypi.python.org/pypi/python-pyasn1-modules/"
""
""
""
""
)

build() {
  cd "$startdir/src/${_srcname}-$pkgver" || return 1
  chown -R root:root .
  find -L . \
    \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
       -o -perm 511 \) -exec chmod 755 {} \; -o \
    \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
       -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

  python3 setup.py install --root="$PKG" || return 1

  find "$PKG" -print0 | xargs -0 file | \
    grep -e "executable" -e "shared object" | grep ELF | \
    cut -f 1 -d : | xargs -r strip --strip-unneeded 2>/dev/null || true

  mkdir -p "$PKG/usr/doc/$pkgname-$pkgver" || return 1
  for f in README* CHANGES* LICENSE* tools; do
    [ -e "$f" ] || continue
    cp -a "$f" "$PKG/usr/doc/$pkgname-$pkgver/" || return 1
  done
}
