pkgname='magic-wormhole'
pkgver=0.12.0
pkgrel=2slinttest
CWD=$(pwd)
export CWD
slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"$pkgname (Securely transfer data between computers)"
)
arch=x86_64
url="https://pypi.python.org/pypi/${pkgname}/${pkgver}"
license=('MIT')
depends=('python3-click' 'python3-cffi' 'python3-autobahn' 'python3-tqdm' 'python3-hkdf' 'python3-pynacl' 'python3-spake2' 'python3-humanize' 'python3-idna' 'python3-service-identity' 'python3-txtorcon')
makedepends=('python3-setuptools')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/${pkgname}/${pkgname}-${pkgver}.tar.gz")
conflicts=("wormhole" "wormhole-server" "python-wormhole")
provides=("wormhole" "wormhole-server" "python-wormhole")
replaces=("wormhole" "wormhole-server" "python-wormhole")
sha512sums=('890c0f1f946dfd9a9bde2ec0079c55dc23b328e04780e6baf8c580dfd068bf37a5b2e00e12119be6529a6e0893d4f711145e04c349ccfdf7ef91e87cef785d36')
docs=("LICENSE" "README.md" "NEWS.md")
build() {
  cd "magic-wormhole-$pkgver" || return 1
  python3 setup.py install --root="$PKG" --optimize=1 || return 1
}
