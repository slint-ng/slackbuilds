# shellcheck shell=bash disable=SC2034
pkgname=piper-tts
pkgver=1.4.1
pkgrel=1slint
slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"$pkgname (fast and local neural text-to-speech engine)"
"Piper is a fast, local neural text-to-speech engine."
)
arch=('x86_64')
url="https://github.com/OHF-Voice/piper1-gpl"
license=('GPL-3.0-or-later')
provides=('piper-tts')
conflicts=('piper-tts' 'piper')
depends=('glibc' 'python3-numpy' 'python3-onnxruntime' 'python3-pathvalidate')
optdepends=(
  'python-flask: http server'
  'python3-onnx: patch voice with alignment'
  'python3-pytorch: train'
)
makedepends=('python3-setuptools' 'python3-build' 'python3-installer' 'python3-wheel' 'python3-scikit-build' 'python3-distro' 'cmake' 'ninja')
source=("https://github.com/OHF-Voice/piper1-gpl/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$SRC/piper1-gpl-${pkgver}" || return 1

  # Upstream tracks espeak-ng via a moving git ref in CMake.
  # Pin to a stable release tag to avoid breakage when espeak-ng master changes.
  espeakNgTag='1.52.0'
  while IFS= read -r cmakeFile; do
    sed -i -E "s/(GIT_TAG[[:space:]]+)(master|main|HEAD)/\\1${espeakNgTag}/g" "$cmakeFile" || return 1
    if rg -q 'espeak-ng/espeak-ng' "$cmakeFile" && ! rg -q 'GIT_TAG' "$cmakeFile"; then
      sed -i "/espeak-ng\\/espeak-ng/a\\  GIT_TAG ${espeakNgTag}" "$cmakeFile" || return 1
    fi
  done < <(rg -l 'espeak-ng/espeak-ng|espeak_ng_external' --glob 'CMakeLists.txt' --glob '*.cmake')

  # Use Slint-packaged build tooling instead of Python-only wrappers.
  sed -i 's/"cmake", "ninja", "scikit-build", "distro"//' pyproject.toml || return 1
  sed -i 's/"scikit-build", "distro", "cmake", "ninja"//' pyproject.toml || return 1
  python3 -m build --wheel --no-isolation --skip-dependency-check || return 1
  python3 -m installer --destdir="$PKG" dist/*.whl || return 1

  # Avoid conflict with the unrelated GTK application named piper.
  mv "$PKG/usr/bin/piper" "$PKG/usr/bin/piper-tts" || return 1
  rm -f "$PKG/usr/COPYING"
}
