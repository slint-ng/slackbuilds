#!/bin/bash
# shellcheck shell=bash disable=SC2034
pkgname=dectalk
pkgver=2023.10.30
pkgrel=1slint
slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"$pkgname (DECtalk text-to-speech engine and tools)"
"DECtalk is a classic text-to-speech system originally from DEC."
"This package builds the open-source community edition."
"It provides command-line tools like gspeak and say."
"The DECtalk libraries are included for applications."
)
url="https://github.com/dectalk/dectalk"
license=("Proprietary")
source=("https://github.com/dectalk/dectalk/archive/refs/tags/2023-10-30.tar.gz"
        "dectalk.patch"
        "dectalk.desktop"
        "paul.png")

build() {
  local src_dir="$SRC/dectalk-2023-10-30"
  [ -d "$src_dir" ] || return 1

  find "$src_dir" -type f \( -name "*.in" -o -name "*.ac" -o -name "*.h" \) -exec dos2unix {} \;
  patch -p1 -d "$src_dir" --verbose < "$SRC/dectalk.patch" || return 1
  cd "$src_dir" || return 1
  cd src || return 1
  autoreconf -si
  ./configure --prefix=/usr
  make
  make DESTDIR="$PKG" install
  install -D -m0644 "$SRC/dectalk.desktop" \
    "$PKG/usr/share/applications/dectalk.desktop"
  install -D -m0644 "$SRC/paul.png" "$PKG/usr/share/pixmaps/paul.png"
}

