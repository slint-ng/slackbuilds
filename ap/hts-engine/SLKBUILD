# Contributor: Ken Swenson <flat@imo.uto.moe>
# included in Slint by Didier Spaier didieratslintdotfr
pkgname=hts-engine
export srcname=hts_engine_API
pkgver=1.10
pkgrel=1slint
slackdesc=(
"$pkgname (HTS Engine command-line frontend)"
"This package provides the hts_engine executable built"
"from the upstream hts_engine API source release."
)
#arch=('i686' 'x86_64')
url="https://sourceforge.net/projects/open-jtalk/"
license=('BSD')
depends=('aaa_libraries|gcc' 'hts_engine_API')
source=("https://sourceforge.net/projects/hts-engine/files/hts_engine%20API/hts_engine_API-1.10/hts_engine_API-1.10.tar.gz"
"10_build_shared_lib.patch")
options=("nosrcpack")
docs=("AUTHORS" "COPYING")

build() {
	cd "${srcname}-$pkgver" || exit 1
	# patch from Debian
	patch -p1 --verbose < "$SRC/10_build_shared_lib.patch" || exit 1
	autoreconf -vif
	./configure \
	--prefix=/usr \
	--libdir=/usr/lib"${LIBDIRSUFFIX}"
	make
	make DESTDIR="$PKG" install
	rm -rf "$PKG"/usr/include "$PKG"/usr/lib"${LIBDIRSUFFIX}"
}
