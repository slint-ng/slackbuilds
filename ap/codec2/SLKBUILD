# shellcheck shell=bash disable=SC2034
# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=codec2
pkgver=1.2.0
pkgrel=1slint
url="https://github.com/drowe67/codec2"
source=("https://github.com/drowe67/codec2/archive/refs/tags/${pkgver}.tar.gz")
docs=("COPYING" "README*")
options=("nosrcpack")

slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"codec2 (open source speech codec)"
"Designed for communications quality speech between 450 and"
"3200 bit/s."
)

build() {
  local _bin

  cmake -B build -S "$SRC/$pkgname-$pkgver" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_SKIP_RPATH=YES \
    -Wno-dev || return 1

  make -C build || return 1
  make -C build DESTDIR="$PKG" install || return 1

  while IFS= read -r -d '' _bin; do
    install -D -m755 "$_bin" -t "$PKG/usr/bin" || return 1
  done < <(find build -type f -regextype posix-extended \
           -regex '.*/(c2(demo|dec|enc|sim)|freedv_(t|r)x|(cohpsk|fdmdv|fsk|ldpc|ofdm)_.*)' \
           -executable -print0)
}
