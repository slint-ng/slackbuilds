pkgname=kImageAnnotator
pkgver=0.6.1
pkgrel=1slint
slackdesc="$pkgname (Tool for annotating images)"
arch=(x86_64)
url='https://github.com/ksnip/kImageAnnotator'
license=(LGPL-3.0-only)
depends=(kColorPicker
         qt5)
makedepends=(cmake)
source=("https://github.com/ksnip/kImageAnnotator/archive/refs/tags/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('8d32f0722dbb59a387d5d07c83a483e1b32f5014183eb67f2a9c5340da73d369')

build() {
  cmake -S "${pkgname}-${pkgver}" -B build \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_SHARED_LIBS=ON
  cmake --build build
  DESTDIR="$PKG" cmake --install build
}
