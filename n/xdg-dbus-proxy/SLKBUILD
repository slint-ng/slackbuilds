# shellcheck shell=bash disable=SC2034,SC2154
# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=xdg-dbus-proxy
pkgver=0.1.2
pkgrel=1slint
source=("https://github.com/flatpak/xdg-dbus-proxy/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.xz")
url="https://github.com/flatpak/xdg-dbus-proxy"

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"xdg-dbus-proxy (filtering proxy for D-Bus)"
"Filters and forwards D-Bus connections."
"Originally part of Flatpak, now standalone."
"Homepage: https://github.com/flatpak/xdg-dbus-proxy"
)

build() {
  ARCH=${ARCH:-${arch:-$(uname -m)}}
  if [ "$ARCH" = "i586" ]; then
    SLKCFLAGS="-O2 -march=i586 -mtune=i686"
    LIBDIRSUFFIX=""
  elif [ "$ARCH" = "i686" ]; then
    SLKCFLAGS="-O2 -march=i686 -mtune=i686"
    LIBDIRSUFFIX=""
  elif [ "$ARCH" = "x86_64" ]; then
    SLKCFLAGS="-O2 -fPIC"
    LIBDIRSUFFIX="64"
  else
    SLKCFLAGS="-O2"
    LIBDIRSUFFIX=""
  fi

  cd "$startdir/src/$pkgname-$pkgver" || exit 1
  chown -R root:root .
  find -L . \
    \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 -o -perm 511 \) -exec chmod 755 {} \; -o \
    \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS" \
  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib${LIBDIRSUFFIX} \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --mandir=/usr/man \
    --docdir=/usr/doc/$pkgname-$pkgver \
    --build=$ARCH-slackware-linux

  make
  make install DESTDIR=$PKG

  find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
    | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

  if [ -d "$PKG/usr/man" ]; then
    find $PKG/usr/man -type f -exec gzip -9 {} \;
    for i in $(find $PKG/usr/man -type l) ; do
      ln -s "$(readlink "$i").gz" "$i.gz"
      rm -f "$i"
    done
  fi

  mkdir -p $PKG/usr/doc/$pkgname-$pkgver
  cp -a COPYING NEWS $PKG/usr/doc/$pkgname-$pkgver
  cat "$startdir/SLKBUILD" > "$PKG/usr/doc/$pkgname-$pkgver/$pkgname.SLKBUILD"
}
