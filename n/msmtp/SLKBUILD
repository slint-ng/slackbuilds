# shellcheck shell=bash disable=SC2034,SC2154
# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=msmtp
pkgver=1.8.20
pkgrel=1slint
source=("https://marlam.de/msmtp/releases/${pkgname}-${pkgver}.tar.xz")
url="https://marlam.de/msmtp/"

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"msmtp (simple SMTP client)"
"msmtp transmits mail to an SMTP server for delivery."
"Configure your mail user agent to call msmtp."
"Use msmtp instead of /usr/sbin/sendmail."
"Homepage: http://msmtp.sourceforge.net"
)

doinst() {
chroot . /usr/bin/install-info /usr/info/msmtp.info.gz /usr/info/dir 2> /dev/null
}

build() {
  ARCH=${ARCH:-${arch:-$(uname -m)}}
  if [ "$ARCH" = "i586" ]; then
    SLKCFLAGS="-O2 -march=i586 -mtune=i686"
    LIBDIRSUFFIX=""
  elif [ "$ARCH" = "i686" ]; then
    SLKCFLAGS="-O2 -march=i686 -mtune=i686"
    LIBDIRSUFFIX=""
  elif [ "$ARCH" = "x86_64" ]; then
    SLKCFLAGS="-O2 -fPIC"
    LIBDIRSUFFIX="64"
  else
    SLKCFLAGS="-O2"
    LIBDIRSUFFIX=""
  fi

  DOCS="AUTHORS COPYING ChangeLog INSTALL NEWS README THANKS doc/msmtprc-system.example doc/msmtprc-user.example"

  cd "$startdir/src/$pkgname-$pkgver" || exit 1
  chown -R root:root .
  find -L . \
    \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 -o -perm 511 \) -exec chmod 755 {} \; -o \
    \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS" \
  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib${LIBDIRSUFFIX} \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --infodir=/usr/info \
    --mandir=/usr/man \
    --docdir=/usr/doc/$pkgname-$pkgver \
    --build=$ARCH-slackware-linux

  make
  make install DESTDIR=$PKG

  find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
    | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

  if [ -d "$PKG/usr/man" ]; then
    find $PKG/usr/man -type f -exec gzip -9 {} \;
    for i in $(find $PKG/usr/man -type l) ; do
      ln -s "$(readlink "$i").gz" "$i.gz"
      rm -f "$i"
    done
  fi

  if [ -d "$PKG/usr/info" ]; then
    rm -f $PKG/usr/info/dir
    gzip -9 $PKG/usr/info/*.info*
  fi

  mkdir -p $PKG/usr/doc/$pkgname-$pkgver
  cp -a $DOCS $PKG/usr/doc/$pkgname-$pkgver
  cat "$startdir/SLKBUILD" > "$PKG/usr/doc/$pkgname-$pkgver/$pkgname.SLKBUILD"
}
