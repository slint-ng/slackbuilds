# shellcheck shell=bash disable=SC2034,SC2154
# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=bitlbee
pkgver=3.6
pkgrel=2slint
source=("https://get.bitlbee.org/src/${pkgname}-${pkgver}.tar.gz"
"BitleBeeMiniHowTo"
"rc.bitlbee")
url="https://www.bitlbee.org"

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"bitlbee (IRC instant messaging gateway)"
"BitlBee bridges IRC with popular messaging networks."
"Buddies appear as IRC users in a channel."
"Conversations use standard IRC private messages."
"Homepage: http://www.bitlbee.org"
)

doinst() {
config() {
  NEW="$1"
  OLD="$(dirname "$NEW")/$(basename "$NEW" .new)"
  if [ ! -r "$OLD" ]; then
    mv "$NEW" "$OLD"
  elif [ "$(cat "$OLD" | md5sum)" = "$(cat "$NEW" | md5sum)" ]; then
    rm "$NEW"
  fi
}
preserve_perms() {
  NEW="$1"
  OLD="$(dirname "$NEW")/$(basename "$NEW" .new)"
  if [ -e "$OLD" ]; then
    cp -a "$OLD" "${NEW}.incoming"
    cat "$NEW" > "${NEW}.incoming"
    mv "${NEW}.incoming" "$NEW"
  fi
  config "$NEW"
}
preserve_perms etc/rc.d/rc.bitlbee.new
config etc/bitlbee/bitlbee.conf.new
config etc/bitlbee/motd.txt.new
}

build() {
  BITLBEE_USER=${BITLBEE_USER:-250}
  BITLBEE_GROUP=${BITLBEE_GROUP:-250}

  ARCH=${ARCH:-${arch:-$(uname -m)}}
  if [ "$ARCH" = "i486" ]; then
    SLKCFLAGS="-O2 -march=i486 -mtune=i686"
    LIBDIRSUFFIX=""
  elif [ "$ARCH" = "i686" ]; then
    SLKCFLAGS="-O2 -march=i686 -mtune=i686"
    LIBDIRSUFFIX=""
  elif [ "$ARCH" = "x86_64" ]; then
    SLKCFLAGS="-O2 -fPIC"
    LIBDIRSUFFIX="64"
  else
    SLKCFLAGS="-O2"
    LIBDIRSUFFIX=""
  fi

  cd "$startdir/src/$pkgname-$pkgver" || exit 1
  chown -R root:root .
  find -L . \
    \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 -o -perm 511 \) \
    -exec chmod 755 {} \; -o \
    \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
    -exec chmod 644 {} \;

  if ! grep -q '^bitlbee:' /etc/passwd; then
    cat << MSG

  You must have a bitlbee user to run this script

  # groupadd -g $BITLBEE_USER bitlbee
  # useradd -u $BITLBEE_USER -d /var/lib/bitlbee -s /bin/false -g bitlbee bitlbee

MSG
    exit 1
  elif ! grep -q '^bitlbee:' /etc/group; then
    cat << MSG

  You must have a bitlbee group to run this script
  # groupadd -g $BITLBEE_GROUP bitlbee

MSG
    exit 1
  fi

  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS" \
  CPU="$ARCH" \
  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib${LIBDIRSUFFIX} \
    --pcdir=/usr/lib${LIBDIRSUFFIX}/pkgconfig \
    --plugindir=/usr/lib${LIBDIRSUFFIX}/${pkgname} \
    --config=/var/lib/${pkgname} \
    --etcdir=/etc/${pkgname} \
    --datadir=/usr/doc/${pkgname}-${pkgver} \
    --mandir=/usr/man \
    --purple=1 \
    --ipv6=1 \
    --plugins=1 \
    --debug=0 \
    --ssl=gnutls \
    --otr=1 \
    --build=$ARCH-slackware-linux

  make all
  make install install-dev install-etc install-doc install-plugins DESTDIR=$PKG

  find $PKG | xargs file | grep -e "executable" -e "shared object" | grep ELF \
    | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

  if [ -d "$PKG/usr/man" ]; then
    find "$PKG/usr/man" -type f -exec gzip -9 {} \;
    for i in $(find "$PKG/usr/man" -type l) ; do
      ln -s "$(readlink "$i").gz" "$i.gz"
      rm -f "$i"
    done
  fi

  mkdir -p $PKG/usr/doc/$pkgname-$pkgver/{oscar,skype} $PKG/var/lib/$pkgname
  cp -a \
    COPYING doc/AUTHORS doc/CHANGES doc/CREDITS doc/FAQ doc/INSTALL \
    doc/README $startdir/BitleBeeMiniHowTo $PKG/usr/doc/$pkgname-$pkgver
  cat "$startdir/SLKBUILD" > "$PKG/usr/doc/$pkgname-$pkgver/$pkgname.SLKBUILD"

  find "$PKG/usr/doc/$pkgname-$pkgver" -type f -exec \
    sed -i 's#/usr/local/#/usr/#' {} \;
  find "$PKG/usr/doc/$pkgname-$pkgver" -type f -exec \
    sed -i 's#/etc/init.d/inetd#/etc/rc.d/rc.inetd#' {} \;

  mv $PKG/etc/$pkgname/$pkgname.conf $PKG/etc/$pkgname/$pkgname.conf.new
  mv $PKG/etc/$pkgname/motd.txt $PKG/etc/$pkgname/motd.txt.new
  chown -R $BITLBEE_USER:$BITLBEE_GROUP $PKG/var/lib/$pkgname

  mkdir -p $PKG/etc/rc.d
  cat $startdir/rc.$pkgname > $PKG/etc/rc.d/rc.$pkgname.new
  chmod 0755 $PKG/etc/rc.d/rc.$pkgname.new
}
