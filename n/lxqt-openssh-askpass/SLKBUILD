# shellcheck shell=bash disable=SC2034,SC2154
# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=lxqt-openssh-askpass
pkgver=2.3.0
pkgrel=2slint
source=("https://github.com/lxqt/lxqt-openssh-askpass/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.xz")
url="https://github.com/lxqt/lxqt-openssh-askpass"

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"lxqt-openssh-askpass (LXQt OpenSSH password prompt)"
"GUI credential prompt for ssh-agent and similar tools."
"Can also be used by other applications such as EncFS."
"Homepage: https://github.com/lxqt/lxqt-openssh-askpass"
)

build() {
  ARCH=${ARCH:-${arch:-$(uname -m)}}
  if [ "$ARCH" = "i586" ]; then
    SLKCFLAGS="-O2 -march=i586 -mtune=i686"
  elif [ "$ARCH" = "i686" ]; then
    SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  elif [ "$ARCH" = "x86_64" ]; then
    SLKCFLAGS="-O2 -fPIC"
  else
    SLKCFLAGS="-O2"
  fi

  cd "$startdir/src/${pkgname}-${pkgver}" || exit 1
  chown -R root:root .
  find -L . \
    \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 -o -perm 511 \) -exec chmod 755 {} \; -o \
    \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

  mkdir -p build
  cd build || exit 1
  cmake \
    -DCMAKE_C_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_CXX_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_MANDIR=/usr/man \
    -DCMAKE_BUILD_TYPE=Release ..
  make
  make install DESTDIR=$PKG
  cd .. || exit 1

  find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
    | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

  if [ -d "$PKG/usr/man" ]; then
    find $PKG/usr/man -type f -exec gzip -9 {} \;
    for i in $(find $PKG/usr/man -type l) ; do
      ln -s "$(readlink "$i").gz" "$i.gz"
      rm -f "$i"
    done
  fi

  find $PKG -name perllocal.pod -o -name ".packlist" -o -name "*.bs" | xargs rm -f || true

  mkdir -p $PKG/usr/doc/$pkgname-$pkgver
  DOCS="AUTHORS CHANGELOG LICENSE README.md"
  cp -a $DOCS $PKG/usr/doc/$pkgname-$pkgver
  cat "$startdir/SLKBUILD" > "$PKG/usr/doc/$pkgname-$pkgver/$pkgname.SLKBUILD"
}
