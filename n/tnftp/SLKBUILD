# shellcheck shell=bash disable=SC2034,SC2154
# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=tnftp
pkgver=20210827
pkgrel=1slint
source=("https://ftp.netbsd.org/pub/NetBSD/misc/lukemftp/${pkgname}-${pkgver}.tar.gz")
url="https://ftp.netbsd.org/pub/NetBSD/misc/lukemftp"

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"tnftp (command-line FTP client)"
"Port of the NetBSD FTP client to other systems."
"Adds editing, completion, URL fetch, and progress display."
"Supports IPv6 and optional SOCKS5 via dante."
)

build() {
  ARCH=${ARCH:-${arch:-$(uname -m)}}
  if [ "$ARCH" = "i586" ]; then
    SLKCFLAGS="-O2 -march=i586 -mtune=i686"
    LIBDIRSUFFIX=""
  elif [ "$ARCH" = "i686" ]; then
    SLKCFLAGS="-O2 -march=i686 -mtune=i686"
    LIBDIRSUFFIX=""
  elif [ "$ARCH" = "x86_64" ]; then
    SLKCFLAGS="-O2 -fPIC"
    LIBDIRSUFFIX="64"
  else
    SLKCFLAGS="-O2"
    LIBDIRSUFFIX=""
  fi

  cd "$startdir/src/$pkgname-$pkgver" || exit 1
  chown -R root:root .
  find -L . -perm /111 -a \! -perm 755 -a -exec chmod 755 {} \+ -o \
         \! -perm /111 -a \! -perm 644 -a -exec chmod 644 {} \+

  runconfig() {
    CFLAGS="$SLKCFLAGS" \
    CXXFLAGS="$SLKCFLAGS" \
    ./configure \
      --prefix=/usr \
      --libdir=/usr/lib$LIBDIRSUFFIX \
      --sysconfdir=/etc/tnftp \
      --mandir=/usr/man \
      --docdir=/usr/doc/$pkgname-$pkgver \
      --build=$ARCH-slackware-linux \
      --enable-editcomplete \
      --with-local-libedit \
      --enable-ssl \
      "$@"
  }

  runconfig --enable-ipv6 --without-socks
  make
  make install-strip DESTDIR=$PKG
  gzip -9 $PKG/usr/man/man1/$pkgname.1

  mv $PKG/usr/bin/$pkgname $PKG/usr/bin/$pkgname.ipv6
  ln -s $pkgname.ipv6 $PKG/usr/bin/$pkgname
  ln -s $pkgname.1.gz $PKG/usr/man/man1/$pkgname.ipv6.1.gz

  if [ "${SOCKS:-yes}" = "yes" -a -e /usr/include/socks.h ]; then
    WITHSOCKS="with"
    make distclean
    runconfig --disable-ipv6 --with-socks
    make
    install -s src/$pkgname $PKG/usr/bin/$pkgname.socks
    ln -s $pkgname.1.gz $PKG/usr/man/man1/$pkgname.socks.1.gz
  else
    WITHSOCKS="without"
  fi

  mkdir -p $PKG/usr/doc/$pkgname-$pkgver
  cp -a COPYING ChangeLog NEWS README THANKS todo $PKG/usr/doc/$pkgname-$pkgver/
  cat "$startdir/SLKBUILD" > "$PKG/usr/doc/$pkgname-$pkgver/$pkgname.SLKBUILD"

}
