# shellcheck shell=bash disable=SC2034,SC2154
#Packager: Didier Spaier <didier~at~slint~dot~fr>

pkgname=orca
pkgver=50.rc
pkgrel=2slint

source=(
	"https://download.gnome.org/sources/orca/50/orca-${pkgver}.tar.xz"
	"orcaprofile"
)
docs=("AUTHORS" "COPYING" "MAINTAINERS" "NEWS" "README.md")
url=https://live.gnome.org/Orca/
options=('nosrcpack')
slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"orca (screen reader)"
"Orca is a free, open source, flexible, and extensible screen reader."
"The xdesktop version is to be used in enviromments other than Gnome3."
""
"Homepage: https://live.gnome.org/Orca/"
)

build() {
	pkgroot="$(dirname "$SRC")" || exit 1
	if [ ! -x /usr/bin/python3.11 ]; then
		echo "$pkgname build requires /usr/bin/python3.11" >&2
		exit 1
	fi
	pythonShimDir="$(mktemp -d)" || exit 1
	ln -s /usr/bin/python3.11 "$pythonShimDir/python3" || exit 1

	cd "$SRC/$pkgname-$pkgver" || exit 1
	PATH="$pythonShimDir:$PATH" \
	CFLAGS="$SLKCFLAGS" \
	CXXFLAGS="$SLKCFLAGS" \
	meson setup --errorlogs \
		--buildtype=release \
		--infodir=/usr/info \
		"--libdir=/usr/lib${LIBDIRSUFFIX}" \
		--localstatedir=/var \
		--mandir=/usr/man \
		--prefix=/usr \
		--sysconfdir=/etc \
		_build || exit 1
	PATH="$pythonShimDir:$PATH" meson compile -C _build || exit 1
	PATH="$pythonShimDir:$PATH" meson install -C _build --destdir="$PKG" || exit 1
	rm -rf "$pythonShimDir"
	# No autostart but orca will be started:
	# - at system level by gdm or lightdm if wished
	# - by the user in graphical environments if ~/autostart/startorca.desktop
	#   shipped in the slint-user-settings package has not Hidden=true
	# The a11y parameters are copied from orcaprofile in ~/.profile
	# by usersettings during installation if sound was used, or by the
	# script orca-on shipped in the slint-misc package.
	rm -rf "$PKG/etc/xdg"
	mkdir -p "$PKG/usr/share/orca" || exit 1
	install -m 644 "$pkgroot/orcaprofile" "$PKG/usr/share/orca/orcaprofile" || exit 1
	(
	cd "$PKG/usr/bin"  || exit
	sed "s;#!/usr/bin/python3;#!/usr/bin/python3.11;" orca > bof
	mv bof orca
	chmod 755 "$PKG/usr/bin/orca"
	)
}
