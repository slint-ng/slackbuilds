#!/bin/bash
# shellcheck shell=bash disable=SC2034,SC2154

# Included in Slint by Didier Spaier <didier~at~slint~dot~fr>

pkgname=wayland-protocols
pkgver=1.45
pkgrel=2slint
arch=noarch
url="https://wayland.freedesktop.org/"
source=("https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/${pkgver}/downloads/${pkgname}-${pkgver}.tar.xz")
docs=("COPYING*" "README.md")

slackdesc=(
#|-----handy-ruler------------------------------------------------------|
"wayland-protocols: wayland-protocols (extended Wayland protocols)"
"wayland-protocols:"
"wayland-protocols: wayland-protocols contains Wayland protocols"
"wayland-protocols: that add functionality not in the core protocol."
"wayland-protocols: These either add new features or extend"
"wayland-protocols: Wayland and protocol extension interfaces."
)

build() {
  cd "$SRC/$pkgname-$pkgver" || return 1

  # noarch metadata can leak impossible -march/-mtune values into Meson.
  export CFLAGS="${CFLAGS//-march=noarch/}"
  export CFLAGS="${CFLAGS//-mtune=noarch/}"
  export CXXFLAGS="${CXXFLAGS//-march=noarch/}"
  export CXXFLAGS="${CXXFLAGS//-mtune=noarch/}"

  meson setup buildDir \
    --prefix=/usr \
    --libdir="lib${LIBDIRSUFFIX}" \
    --libexecdir=/usr/libexec \
    --bindir=/usr/bin \
    --sbindir=/usr/sbin \
    --includedir=/usr/include \
    --datadir=/usr/share \
    --mandir=/usr/man \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release || return 1

  meson compile -C buildDir -j "$numjobs" || return 1
  DESTDIR="$PKG" meson install -C buildDir || return 1
}
