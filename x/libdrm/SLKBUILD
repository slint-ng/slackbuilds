#!/bin/bash
# shellcheck shell=bash disable=SC2034,SC2154

# Included in Slint by Didier Spaier didieratslintdotfr

pkgname=libdrm
pkgver=2.4.125
pkgrel=2slint
url="https://dri.freedesktop.org/libdrm/"
source=("https://dri.freedesktop.org/${pkgname}/${pkgname}-${pkgver}.tar.xz")
docs=("CONTRIB*" "README*" "RELEAS*")
options=("nosrcpack")

slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"libdrm (direct rendering manager userspace library)"
""
"libdrm provides the userspace interface to the kernel DRM"
"services used for hardware-accelerated graphics rendering."
)

build() {
  local legacyDocName
  local -a mesonArgs
  local -a ninjaArgs

  legacyDocName="${pkgname}.S""lackBuild"

  if [ -n "${NUMJOBS:-}" ]; then
    read -r -a ninjaArgs <<< "${NUMJOBS}"
  else
    ninjaArgs=(-j"$(( $(nproc) + 1 ))")
  fi

  mesonArgs=(
    --prefix=/usr
    --libdir="lib${LIBDIRSUFFIX}"
    --libexecdir=/usr/libexec
    --bindir=/usr/bin
    --sbindir=/usr/sbin
    --includedir=/usr/include
    --datadir=/usr/share
    --mandir=/usr/man
    --sysconfdir=/etc
    --localstatedir=/var
    --buildtype=release
    -Dudev=true
    -Dintel=enabled
  )

  if python3 -c 'import docutils' >/dev/null 2>&1; then
    mesonArgs+=(-Dman-pages=enabled)
  else
    mesonArgs+=(-Dman-pages=disabled)
  fi

  cd "$SRC/$pkgname-$pkgver" || return 1

  meson setup meson-build "${mesonArgs[@]}" || return 1

  "${NINJA:=ninja}" -C meson-build "${ninjaArgs[@]}" || return 1
  DESTDIR="$PKG" "${NINJA:=ninja}" -C meson-build install || return 1

  install -Dm0644 "$SRC/../SLKBUILD" \
    "$PKG/usr/doc/$pkgname-$pkgver/$legacyDocName" || return 1
}
